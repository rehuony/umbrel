{
	"name": "backend",
	"type": "module",
	"version": "2.0.0",
	"versionName": "umbrelOS 2.0",
	"main": "./source/index.ts",
	"bin": {
		"umbreld": "./umbreld"
	},
	"license": "PolyForm Noncommercial License 1.0.0",
	"private": true,
	"scripts": {
		"start": "./source/cli.ts",
		"client": "UMBREL_DATA_DIR=./data UMBREL_TRPC_ENDPOINT=http://localhost:3001/trpc pnpm start client",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"typecheck": "tsc --noEmit",
		"test": "vitest --reporter verbose --run --testTimeout 600000 --hookTimeout 600000",
		"test:unit": "pnpm test unit.test",
		"test:integration": "pnpm test integration.test",
		"test:coverage": "open ./coverage/index.html",
		"watch": "NODE_ENV=development nodemon --legacy-watch --ext js,json,ts --watch source --exec",
		"dev": "FORCE_COLOR=1 UMBREL_UI_PROXY=http://127.0.0.1:3000 pnpm watch \"./source/cli.ts --data-directory /home/umbrel/umbrel --log-level verbose\"",
		"dev:production-mode": "FORCE_COLOR=1 pnpm start --data-directory /home/umbrel/umbrel",
		"todo": "git grep --line-number TODO -- ':!package.json'",
		"test:vm": "pnpm test vm.test",
		"test:umbrel-dev:prepare": "cd ../.. && ./scripts/umbrel-dev.sh exec:noninteractive -- bash -c 'systemctl stop umbrel; cd /umbrel-dev; pnpm install --frozen-lockfile'",
		"test:umbrel-dev": "cd ../.. && ./scripts/umbrel-dev.sh exec:noninteractive -- pnpm --dir /umbrel-dev --filter backend test"
	},
